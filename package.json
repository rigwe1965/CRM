    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:reset": "tsx scripts/safe-reset.ts",
    "db:verify": "tsx scripts/verify-restore.ts",
    "db:smoke": "tsx scripts/restore-smoke.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "vercel-build": "if [ \"$VERCEL_ENV\" = \"production\" ]; then DIRECT_URL=\"${DIRECT_URL:-$DATABASE_URL_UNPOOLED}\" prisma migrate deploy; fi && next build",
