# PostgreSQL connection (pooled URL if using Neon/Supabase)
DATABASE_URL="postgresql://crm:crm@localhost:5432/crm?schema=public"
# Direct (non-pooled) URL used by migrations. Same as DATABASE_URL for local Postgres.
DIRECT_URL="postgresql://crm:crm@localhost:5432/crm?schema=public"
# Production, row-level security: DATABASE_URL connects as the restricted role "crm_app"; DIRECT_URL and this one as the
# owner role. Work that spans businesses (sign-in, daily jobs, the Stripe webhook) uses it. Unset = same as DATABASE_URL
# (fine for local development, where the single owner role is not held back by the policies). See TECHNICIAN.md.
# PLATFORM_DATABASE_URL="postgresql://crm:crm@localhost:5432/crm?schema=public"

# Auth.js. Generate the secret with: npx auth secret   (or: openssl rand -base64 32)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""
# Required when running `next start` / self-hosting behind your own domain (not needed in `next dev` or on Vercel)
# AUTH_TRUST_HOST=true
# Self-hosting only: how many reverse proxies (nginx, load balancer) sit in front of the app. Rate limits
# read the client IP that many places from the right of X-Forwarded-For. Default 1. Ignored on Vercel.
# TRUSTED_PROXY_COUNT=1

# Password given to all seeded users (development only)
SEED_USER_PASSWORD="ChangeMe123!"

# ── Email ──────────────────────────────────────────────
# Welcome, password reset, magic link, deal-stage, task-reminder and contact emails.
# Provider order: RESEND_API_KEY (preferred) → EMAIL_SERVER (SMTP) → console in development.
# Production requires one of them. With neither set in development, emails are printed to the server console.
# RESEND_API_KEY="re_..."
# EMAIL_SERVER="smtp://user:pass@smtp.example.com:587"
# Must be on a domain verified with your provider. (Resend test sender: "CRM <onboarding@resend.dev>", only delivers to your own address.)
# EMAIL_FROM="CRM <noreply@your-domain.com>"

# ── Production ─────────────────────────────────────────
# Protects /api/cron/* (Vercel Cron sends it as a Bearer token). Generate: openssl rand -base64 32
# CRON_SECRET=""
# Online payment links (Stripe). STRIPE_*, WHATSAPP_* and LEAD_FORM_ORIGINS below are now the ORIGINAL business's
# settings only; every other business saves its own through /api/admin/integrations (TECHNICIAN.md). Both or neither. Use sk_test_/rk_test_ keys until you go live.
# The webhook secret (whsec_...) comes from `stripe listen` locally, or the Stripe dashboard in production.
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# Websites allowed to send the enquiry form to this CRM from a visitor's browser (comma separated, no trailing slash).
# LEAD_FORM_ORIGINS="https://www.your-website.com"
# Two-way WhatsApp (Meta WhatsApp Business Cloud API). All four or none. The webhook URL to give Meta is
# https://<your-crm-domain>/api/webhooks/whatsapp and the verify token is whatever you put below (16+ characters).
# WHATSAPP_ACCESS_TOKEN=""     # permanent system-user token
# WHATSAPP_PHONE_NUMBER_ID=""  # the number's ID in Meta (not the phone number itself)
# WHATSAPP_APP_SECRET=""       # Meta app secret, used to check that messages really come from Meta
# WHATSAPP_VERIFY_TOKEN=""     # you invent this; Meta sends it back once when you save the webhook
# Ivy, the AI assistant (AI_ASSISTANT_PLAN.md). Each business adds its own Anthropic key in Settings; this one is used only by
# the original business until it saves its own. A standard API key (sk-ant-...), not an admin key.
# ANTHROPIC_API_KEY=""
# Self-service sign-up and subscriptions (off unless SIGNUP_ENABLED=1). Billing uses the PLATFORM's own Stripe account,
# not a business's. Webhook endpoint to add there: https://<your-crm-domain>/api/webhooks/billing
# SIGNUP_ENABLED=1
# CAPTCHA on the sign-up form (Cloudflare Turnstile, free: dash.cloudflare.com -> Turnstile). Both keys, or neither (dev only).
# TURNSTILE_SITE_KEY=""        # public
# TURNSTILE_SECRET_KEY=""      # server only
# TRIAL_DAYS=14
# BILLING_STRIPE_SECRET_KEY=""
# BILLING_STRIPE_WEBHOOK_SECRET=""
# BILLING_PRICE_STARTER=""   # Stripe price id of the Starter plan
# BILLING_PRICE_PRO=""       # Stripe price id of the Pro plan
# BILLING_AUTOMATIC_TAX=1    # charge VAT/GST/sales tax at checkout with Stripe Tax; set only after Stripe Tax is set up (LAUNCH_RUNBOOK.md, section 5)
# Shared rate limiting across serverless instances (free Upstash Redis). Without it limits are per instance only.
UPSTASH_REDIS_REST_URL=""   # required in production
UPSTASH_REDIS_REST_TOKEN=""
# Optional: a dedicated key for encrypting two-step secrets (otherwise derived from NEXTAUTH_SECRET, which
# then can't be rotated without resetting everyone's two-step setup). Generate: openssl rand -base64 32
# To rotate: move the old value to MFA_ENCRYPTION_KEY_PREVIOUS and set a new MFA_ENCRYPTION_KEY.
# MFA_ENCRYPTION_KEY=""
# MFA_ENCRYPTION_KEY_PREVIOUS=""
# Admins must use two-step verification: until they enrol they get a plain SALES session.
# Default: on in production, off in development. Set 0 to switch off, 1 to force on.
# REQUIRE_ADMIN_MFA=1
# Content Security Policy: set 1 to only log violations in the browser console instead of blocking them
# (use this while checking a new deployment; scripts are normally allowed only with a per-request nonce).
# CSP_REPORT_ONLY=1
# Skip the startup environment check (not recommended)
# SKIP_ENV_VALIDATION=1
