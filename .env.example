# PostgreSQL connection (pooled URL if using Neon/Supabase)
DATABASE_URL="postgresql://crm:crm@localhost:5432/crm?schema=public"
# Direct (non-pooled) URL used by migrations. Same as DATABASE_URL for local Postgres.
DIRECT_URL="postgresql://crm:crm@localhost:5432/crm?schema=public"

# Auth.js. Generate the secret with: npx auth secret   (or: openssl rand -base64 32)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""
# Required when running `next start` / self-hosting behind your own domain (not needed in `next dev` or on Vercel)
# AUTH_TRUST_HOST=true

# Password given to all seeded users (development only)
SEED_USER_PASSWORD="ChangeMe123!"

# ── Email ──────────────────────────────────────────────
# Welcome, password reset, magic link, deal-stage, task-reminder and contact emails.
# Provider order: RESEND_API_KEY (preferred) → EMAIL_SERVER (SMTP) → console in development.
# Production requires one of them. With neither set in development, emails are printed to the server console.
# RESEND_API_KEY="re_..."
# EMAIL_SERVER="smtp://user:pass@smtp.example.com:587"
# Must be on a domain verified with your provider. (Resend test sender: "CRM <onboarding@resend.dev>", only delivers to your own address.)
# EMAIL_FROM="CRM <noreply@your-domain.com>"

# ── Production ─────────────────────────────────────────
# Protects /api/cron/* (Vercel Cron sends it as a Bearer token). Generate: openssl rand -base64 32
# CRON_SECRET=""
# Shared rate limiting across serverless instances (free Upstash Redis). Without it limits are per instance only.
UPSTASH_REDIS_REST_URL=""   # required in production
UPSTASH_REDIS_REST_TOKEN=""
# Skip the startup environment check (not recommended)
# SKIP_ENV_VALIDATION=1
