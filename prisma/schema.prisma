generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ──────────────────────────────────────────────

enum Role {
  ADMIN
  SALES
  SUPPORT
}

enum ContactType {
  LEAD
  PROSPECT
  CUSTOMER
  PARTNER
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
}

enum DealStage {
  QUALIFICATION
  DISCOVERY
  PROPOSAL
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  CANCELLED
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  DIGITAL
  OTHER
}

enum PaymentSource {
  MANUAL
  ONLINE
}

enum PaymentLinkStatus {
  PENDING
  PAID
  CANCELLED
  // Paid online but the deal balance had dropped meanwhile: not recorded, the owner must refund it.
  REFUND_NEEDED
}

enum ActivityType {
  NOTE
  CALL
  EMAIL
  MEETING
  WHATSAPP
}

// Where a sold order is on its way to the customer. Separate from the sales stage (DealStage).
enum FulfilmentStatus {
  NOT_STARTED
  PACKED
  SHIPPED
  DELIVERED
  RETURNED
}

// Which way a message went. Only set on WhatsApp activities.
enum ActivityDirection {
  IN
  OUT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ─── Users & Auth.js tables ─────────────────────────────

model User {
  id                String    @id @default(cuid())
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id])
  email             String    @unique
  name              String
  passwordHash      String?
  role              Role      @default(SALES)
  isActive          Boolean   @default(true)
  emailVerified     DateTime?
  image             String?
  // Sessions issued before this moment are rejected (set on password change/reset).
  passwordChangedAt DateTime?
  // Two-step verification (TOTP). mfaSecret is AES-GCM encrypted; it is set before mfaEnabledAt (pending setup).
  mfaSecret         String?
  mfaEnabledAt      DateTime?
  mfaLastStep       Int?
  mfaRecoveryCodes  String[]  @default([])
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  accounts           Account[]
  sessions           Session[]
  ownedOrganizations Organization[]    @relation("OrganizationOwner")
  ownedContacts      Contact[]         @relation("ContactOwner")
  ownedDeals         Deal[]            @relation("DealOwner")
  activities         Activity[]
  assignedTasks      Task[]            @relation("TaskAssignee")
  createdTasks       Task[]            @relation("TaskCreator")
  ownedInvoices      Invoice[]         @relation("InvoiceOwner")
  stockAdjustments   StockAdjustment[] @relation("StockAdjustmentOwner")
  recordedPayments   Payment[]         @relation("PaymentRecorder")
  paymentLinks       PaymentLink[]     @relation("PaymentLinkCreator")
  customerOrderLinks CustomerOrderLink[] @relation("CustomerOrderLinkCreator")
  campaigns          Campaign[]          @relation("CampaignCreator")
  savedFilters       SavedFilter[]
  aiConversations    AiConversation[]
  // Mutes the daily "Suggested actions" for this person (they can turn them back on in the Ivy panel).
  aiSuggestionsMuted Boolean   @default(false)
  aiProposals       AiProposal[]
  aiInboxRuns       AiInboxRun[]

  @@index([role])
  @@index([tenantId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// One run of a platform job (the daily cron). Belongs to no business; only the platform client reads or writes it.
model JobRun {
  id         String    @id @default(cuid())
  job        String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  /// null while running, true when every step worked, false when the job threw or a step reported failure
  ok         Boolean?
  summary    Json?

  @@index([job, startedAt])
}

// ─── Tenants ────────────────────────────────────────────

// One business using this CRM. Phase 0 of MULTI_TENANCY_PLAN.md: every business table carries a tenantId.
// The column defaults to the original business ("tenant_ivycandy", created by the migration) so the app keeps
// working unchanged until Phase 1 makes every query and every create tenant-aware; Phase 1 then drops the default.
enum TenantStatus {
  ACTIVE
  SUSPENDED
  // Signed up but the admin has not confirmed their email yet: nobody can sign in, and the signup is deleted after a week.
  PENDING
}

enum BillingStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

model Tenant {
  id         String       @id @default(cuid())
  name       String
  slug       String       @unique
  status     TenantStatus @default(ACTIVE)
  plan       String       @default("internal")
  // Shown to customers (e.g. in reminder emails) and used as the email sender name.
  brandName  String?
  senderName String?
  // Subscription (Phase 4). The original business is plan "internal": never limited, never read-only.
  billingStatus        BillingStatus @default(ACTIVE)
  trialEndsAt          DateTime?
  stripeCustomerId     String?       @unique
  stripeSubscriptionId String?       @unique
  currentPeriodEnd     DateTime?
  // When the last billing event was applied, so a late-arriving older event can't undo a newer one.
  billingEventAt       DateTime?
  // Set when an admin asked to delete the business: read-only from then on, erased for good after the grace period (Phase 5).
  deletionRequestedAt  DateTime?
  // The business's own sending address for mail to its customers (Phase 5 follow-up). Usable only once the domain is
  // verified with the email provider; senderDomain is unique so two businesses can't claim the same one.
  senderDomain         String?       @unique
  senderLocalPart      String?
  senderDomainId       String?
  senderVerifiedAt     DateTime?
  // When the current domain was claimed. An unverified claim lapses after SENDER_CLAIM_DAYS (src/lib/sender.ts).
  senderClaimedAt      DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  users               User[]
  organizations       Organization[]
  contacts            Contact[]
  deals               Deal[]
  activities          Activity[]
  tasks               Task[]
  tags                Tag[]
  contactTags         ContactTag[]
  savedFilters        SavedFilter[]
  emailTemplates      EmailTemplate[]
  whatsappTemplates   WhatsappTemplate[]
  campaigns           Campaign[]
  campaignRecipients  CampaignRecipient[]
  automationSettings  AutomationSetting[]
  integrations        TenantIntegration[]
  invoices            Invoice[]
  invoiceItems        InvoiceItem[]
  payments            Payment[]
  paymentLinks        PaymentLink[]
  customerOrderLinks  CustomerOrderLink[]
  instalments         Instalment[]
  instalmentReminders InstalmentReminder[]
  dealItems           DealItem[]
  stockAdjustments    StockAdjustment[]
  stockThresholds     StockThreshold[]
  aiConversations     AiConversation[]
  aiProposals        AiProposal[]
  aiInboxRuns        AiInboxRun[]
  aiTriages          AiTriage[]
  knowledgeEntries    KnowledgeEntry[]
  knowledgeVersions   KnowledgeEntryVersion[]
  aiMessages          AiMessage[]
  aiUsage             AiUsage[]
}

// ─── CRM core ───────────────────────────────────────────

model Organization {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  name      String
  domain    String?
  industry  String?
  size      Int?
  website   String?
  phone     String?
  address   String?
  city      String?
  state     String?
  country   String?
  ownerId   String?
  // Soft delete: rows with deletedAt set are hidden by the API.
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  owner      User?      @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  contacts   Contact[]
  deals      Deal[]
  activities Activity[]

  @@unique([tenantId, domain])
  @@index([name])
  @@index([ownerId])
  @@index([industry])
  @@index([deletedAt])
  @@index([tenantId])
}

model Contact {
  id             String      @id @default(cuid())
  tenantId       String
  tenant         Tenant      @relation(fields: [tenantId], references: [id])
  firstName      String
  lastName       String
  email          String?
  phone          String?
  // `phone` normalised to E.164 (+4915906462275); null when it can't be worked out. Kept in sync by the contact routes.
  phoneE164      String?
  // When true, no automatic emails (such as instalment reminders) are sent to this contact.
  emailOptOut    Boolean     @default(false)
  // When true, the customer has agreed to WhatsApp messages from the business (payment reminders). Off until someone records it.
  whatsappOptIn  Boolean     @default(false)
  // When and how that agreement was recorded (null for ticks made before this was kept). Cleared when it is withdrawn.
  whatsappOptInAt     DateTime?
  whatsappOptInSource String?
  title          String?
  type           ContactType @default(LEAD)
  leadStatus     LeadStatus? @default(NEW)
  source         String?
  // Shipping / home address
  address        String?
  city           String?
  state          String?
  postalCode     String?
  country        String?
  organizationId String?
  ownerId        String?
  // Soft delete: rows with deletedAt set are hidden by the API.
  deletedAt      DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  owner        User?         @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  deals        Deal[]
  activities   Activity[]
  tasks        Task[]
  tags         ContactTag[]
  campaignRecipients CampaignRecipient[]

  @@unique([tenantId, email])
  @@index([lastName, firstName])
  @@index([type])
  @@index([leadStatus])
  @@index([organizationId])
  @@index([ownerId])
  @@index([deletedAt])
  @@index([phoneE164])
  @@index([tenantId])
  // Lists are always one business, newest or A-Z first (Phase 3, PHASE3_BASELINE.md).
  @@index([tenantId, deletedAt])
  @@index([tenantId, createdAt])
  @@index([tenantId, lastName, firstName])
  @@index([tenantId, ownerId, createdAt])
  // Search is ILIKE '%text%': trigram indexes (pg_trgm) let the database use an index for it.
  @@index([lastName(ops: raw("gin_trgm_ops"))], type: Gin, map: "Contact_lastName_trgm_idx")
  @@index([firstName(ops: raw("gin_trgm_ops"))], type: Gin, map: "Contact_firstName_trgm_idx")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "Contact_email_trgm_idx")
  @@index([phone(ops: raw("gin_trgm_ops"))], type: Gin, map: "Contact_phone_trgm_idx")
}

model Deal {
  id                String    @id @default(cuid())
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id])
  title             String
  amount            Decimal   @default(0) @db.Decimal(14, 2)
  currency          String    @default("USD")
  stage             DealStage @default(QUALIFICATION)
  probability       Int       @default(10)
  expectedCloseDate DateTime?
  closedAt          DateTime?
  lostReason        String?
  // Shipping: only used once the deal is won. Moving the status sets shippedAt / deliveredAt.
  fulfilmentStatus  FulfilmentStatus @default(NOT_STARTED)
  carrier           String?
  trackingNumber    String?
  shippedAt         DateTime?
  deliveredAt       DateTime?
  // Hair order details (all optional)
  productType       String?
  texture           String?
  lengthInches      String?
  color             String?
  laceType          String?
  quantity          Int?
  organizationId    String?
  contactId         String?
  ownerId           String
  // Soft delete: rows with deletedAt set are hidden by the API.
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  contact      Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  owner        User          @relation("DealOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  activities   Activity[]
  tasks        Task[]
  invoices     Invoice[]
  payments     Payment[]
  paymentLinks PaymentLink[]
  customerOrderLinks CustomerOrderLink[]
  instalments  Instalment[]
  items        DealItem[]

  @@index([stage])
  @@index([expectedCloseDate])
  @@index([ownerId, stage])
  @@index([organizationId])
  @@index([contactId])
  @@index([deletedAt])
  @@index([tenantId])
  @@index([tenantId, stage, closedAt])
  @@index([tenantId, fulfilmentStatus])
}

model Activity {
  id             String             @id @default(cuid())
  tenantId       String
  tenant         Tenant             @relation(fields: [tenantId], references: [id])
  type           ActivityType       @default(NOTE)
  subject        String
  body           String?
  occurredAt     DateTime           @default(now())
  direction      ActivityDirection?
  // WhatsApp message id (wamid…). Unique, so Meta delivering the same message twice records it once.
  externalId     String?            @unique
  // For an outgoing WhatsApp message: what Meta last told us (SENT, DELIVERED, READ or FAILED). Null until it tells us.
  deliveryStatus String?
  // Meta's reason when deliveryStatus is FAILED.
  deliveryError  String?
  authorId       String
  contactId      String?
  dealId         String?
  organizationId String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  author       User          @relation(fields: [authorId], references: [id], onDelete: Restrict)
  contact      Contact?      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deal         Deal?         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([occurredAt])
  @@index([authorId])
  @@index([contactId])
  @@index([dealId])
  @@index([organizationId])
  @@index([tenantId])
  @@index([tenantId, occurredAt])
}

model Task {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  title          String
  description    String?
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  dueDate        DateTime?
  completedAt    DateTime?
  // Set when the due-soon reminder email went out; cleared when the due date changes.
  reminderSentAt DateTime?
  // Set on tasks created by an automation (e.g. "stage:<dealId>:<stage>", "quiet:<contactId>"): lets a rule see
  // that it has already made this task instead of making it twice.
  automationKey  String?
  assigneeId     String
  createdById    String
  contactId      String?
  dealId         String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  assignee  User     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  createdBy User     @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([assigneeId, status, dueDate])
  @@index([createdById])
  @@index([contactId])
  @@index([dealId])
  @@index([automationKey])
  @@index([tenantId])
}

// ─── Tags and saved filters ─────────────────────────────

// A label the team puts on contacts ("wholesale", "VIP", "curly") to find them as a group.
model Tag {
  id        String       @id @default(cuid())
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id])
  name      String
  createdAt DateTime     @default(now())
  contacts  ContactTag[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model ContactTag {
  contactId String
  tenantId  String
  tenant    Tenant @relation(fields: [tenantId], references: [id])
  tagId     String

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@index([tagId])
  @@index([tenantId])
}

// A person's own named set of list filters (today for the contacts list), shown as one-click chips.
model SavedFilter {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  userId    String
  entity    String
  name      String
  query     Json
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entity, name])
  @@index([tenantId])
}

// ─── Email templates ────────────────────────────────────

// Wording the team picks in the "Email a contact" dialog. Shared by everyone, managed by admins. The words
// {firstName}, {lastName}, {company} and {senderName} are filled in when a template is chosen.
model EmailTemplate {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  name        String
  subject     String
  body        String
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
}

// A WhatsApp message template as Meta knows it. Templates are created and approved in Meta's WhatsApp Manager;
// "Refresh from Meta" copies them here (name, language, wording, status). `slots` says what fills {{1}}, {{2}}...:
// [{ "label": "First name", "source": "firstName" }]. A template Meta no longer lists is kept with status REMOVED.
model WhatsappTemplate {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  name         String
  language     String
  category     String   @default("UTILITY")
  body         String
  // APPROVED, PENDING, REJECTED, PAUSED, DISABLED or REMOVED (as Meta reports it).
  status       String   @default("PENDING")
  // False when the template has a media header, a button with a variable or named variables, which this CRM does not send yet.
  supported    Boolean  @default(true)
  active       Boolean  @default(true)
  slots        Json     @default("[]")
  metaId       String?
  lastSyncedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  campaigns    Campaign[]

  @@unique([tenantId, name, language])
  @@index([tenantId, status])
}

// ─── Broadcast campaigns ────────────────────────────────

enum CampaignStatus {
  DRAFT
  QUEUED
  SENDING
  PAUSED
  COMPLETED
  STOPPED
}

enum CampaignRecipientStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
  SKIPPED
}

// One approved WhatsApp template sent to a chosen group of opted-in customers. Admin only. `audience` holds the filter
// (tags, types, ...) and `values` the text for blanks that are typed once for everyone.
model Campaign {
  id          String         @id @default(cuid())
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  name        String
  templateId  String
  template    WhatsappTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  audience    Json           @default("{}")
  values      Json           @default("[]")
  status      CampaignStatus @default(DRAFT)
  createdById String
  createdBy   User           @relation("CampaignCreator", fields: [createdById], references: [id], onDelete: Restrict)
  // Set when a test message was sent to the admin; cleared by any edit, so what was tested is what goes out.
  testedAt    DateTime?
  // How many customers the admin confirmed when starting.
  audienceSize Int?
  // Why a PAUSED campaign is paused: DAILY_LIMIT, META_RATE_LIMIT, TOO_MANY_FAILURES or TEMPLATE_UNAVAILABLE.
  pausedReason String?
  // While a batch is being sent, until when no other batch may start (two tabs or the daily job never overlap).
  lockedUntil DateTime?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  recipients CampaignRecipient[]

  @@index([tenantId, status])
  @@index([templateId])
  @@index([createdById])
}

// One customer in one campaign. The unique pair is what stops anyone getting the same campaign twice.
model CampaignRecipient {
  id         String                  @id @default(cuid())
  tenantId   String
  tenant     Tenant                  @relation(fields: [tenantId], references: [id])
  campaignId String
  campaign   Campaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId  String
  contact    Contact                 @relation(fields: [contactId], references: [id], onDelete: Cascade)
  status     CampaignRecipientStatus @default(PENDING)
  reason     String?
  messageId  String?
  sentAt     DateTime?
  createdAt  DateTime                @default(now())

  @@unique([campaignId, contactId])
  @@index([tenantId, campaignId, status])
  @@index([contactId])
}

// ─── Automations ────────────────────────────────────────

// Admin overrides for the built-in automations (key "stage-tasks", "quiet-leads"). Defaults live in code
// (src/lib/automations/config.ts); a missing row means "defaults", which are all switched off.
model AutomationSetting {
  key         String
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  config      Json
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@id([tenantId, key])
  @@index([tenantId])
}

// A business's own connections to outside services (Phase 3 of MULTI_TENANCY_PLAN.md). `config` is the settings as
// JSON, encrypted at rest (src/lib/integrations.ts); it never leaves the server in a response.
enum IntegrationKind {
  STRIPE
  WHATSAPP
  LEAD_FORM
  // The business's own Anthropic API key, used by the Ivy assistant (AI_ASSISTANT_PLAN.md).
  ANTHROPIC
}

model TenantIntegration {
  id          String          @id @default(cuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  kind        IntegrationKind
  config      String
  updatedById String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([tenantId, kind])
}

// ─── Ivy, the AI assistant (AI_ASSISTANT_PLAN.md) ───────

enum AiRole {
  USER
  ASSISTANT
}

enum AiProposalKind {
  TASK_CREATE
  TASK_CHANGE
  NOTE_CREATE
  STAGE_CHANGE
  MESSAGE_DRAFT
  PAYMENT_RECORD
  CONTACT_CREATE
  DEAL_CREATE
  SCHEDULE_REPLACE
  CONTACT_OPT_OUT
}

enum AiProposalSource {
  CHAT
  DAILY
  WHATSAPP
}

enum AiProposalStatus {
  PENDING
  APPLIED
  DECLINED
  EXPIRED
  FAILED
}

// One chat between a user and Ivy. Visible only to that user; purged after AI_RETENTION_DAYS (src/lib/ai/retention.ts).
model AiConversation {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("New conversation")
  // The version of Ivy's instructions and tools this chat was started with (src/lib/ai/prompt.ts). A chat can only be
  // continued while it matches: the model's thinking blocks are only valid if the prompt and tools are unchanged.
  promptVersion String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages  AiMessage[]
  proposals AiProposal[]

  @@index([tenantId, userId, updatedAt])
  @@index([updatedAt])
}

// Messages are kept exactly as the model sent and received them (`content` is the list of content blocks): thinking
// blocks are only valid unedited, so history is never trimmed or summarised, only ended and restarted.
model AiMessage {
  id             String         @id @default(cuid())
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  position       Int
  role           AiRole
  content        Json
  createdAt      DateTime       @default(now())

  @@unique([conversationId, position])
  @@index([tenantId])
}

// One row per model call: tokens and an estimated cost, so the monthly ceiling can be enforced. userId and
// conversationId are plain ids (no foreign keys) so the history of spend outlives a purged chat or a removed user.
model AiUsage {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id])
  userId           String?
  conversationId   String?
  model            String
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  // Estimated cost in millionths of a US dollar (1_000_000 = $1), from the price table in src/lib/ai/pricing.ts.
  costMicros       Int      @default(0)
  // What the call was for: CHAT, INBOX (daily suggestions) or TRIAGE (WhatsApp), so Settings can show where the money goes.
  purpose          String   @default("CHAT")
  createdAt        DateTime @default(now())

  @@index([tenantId, createdAt])
}

// What Ivy suggested and what the person decided (AI_ASSISTANT_PLAN.md, Phase 2). `params` is the exact action, validated
// when it was proposed and again when approved; `preview` is the card text built from it by the server. A proposal
// writes nothing to the business until the person approves it, and is decided once. Removed with its conversation.
model AiProposal {
  id             String              @id @default(cuid())
  tenantId       String
  tenant         Tenant              @relation(fields: [tenantId], references: [id])
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Null for suggestions Ivy made on her own (the daily inbox, WhatsApp triage), which belong to no chat.
  conversationId String?
  conversation   AiConversation?     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  source         AiProposalSource    @default(CHAT)
  // Stops the same suggestion being made twice (rule, record and ISO week); unique per business and person.
  dedupeKey      String?
  // Why Ivy suggested it, in words built from data ("Instalment 2 was due 5 days ago"). Shown on the card.
  reason         String?
  subjectType    String?
  subjectId      String?
  kind           AiProposalKind
  status         AiProposalStatus    @default(PENDING)
  params         Json
  preview        Json
  // What the approval produced, so the card can link to it (e.g. entity "task").
  resultEntity   String?
  resultId       String?
  // Why an approval did nothing (the record changed, was deleted...), in words for the person.
  failure        String?
  createdAt      DateTime            @default(now())
  expiresAt      DateTime
  decidedAt      DateTime?
  // Set once Ivy has been told the outcome (in the person's next message).
  reportedAt     DateTime?

  @@unique([tenantId, userId, dedupeKey])
  @@index([tenantId, userId, status, createdAt])
  @@index([tenantId, userId, source, status])
  @@index([conversationId])
  @@index([createdAt])
}

// One row per person per day for the daily "Suggested actions" run, so a day's suggestions are made once however often
// the app is opened (AI_ASSISTANT_PLAN.md, Phase 3b). `day` is the UTC date, as text.
model AiInboxRun {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  day        String
  status     String    @default("RUNNING")
  candidates Int       @default(0)
  created    Int       @default(0)
  costMicros Int       @default(0)
  error      String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@unique([tenantId, userId, day])
  @@index([startedAt])
}

// The queue behind WhatsApp triage (AI_ASSISTANT_PLAN.md, Phase 3c): one row per customer message, made when the
// webhook files it, so a retry from Meta or a crash never triages a message twice and a sweep can finish what was left.
// Holds the verdict (label, urgency, a short summary) and no message text.
model AiTriage {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  activityId  String
  contactId   String
  // PENDING, RUNNING, DONE, FAILED, SKIPPED
  status      String    @default("PENDING")
  // Why it was skipped (no model call made), in a few fixed words.
  skipReason  String?
  attempts    Int       @default(0)
  // Whether the model was called for this message; counts against the business's daily cap.
  modelCalled Boolean   @default(false)
  label       String?
  urgency     String?
  summary     String?
  cards       Int       @default(0)
  costMicros  Int       @default(0)
  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?

  @@unique([tenantId, activityId])
  @@index([tenantId, createdAt])
  @@index([tenantId, contactId, createdAt])
  @@index([status, createdAt])
}

// The business's own written answers (return policy, FAQs) that Ivy looks up before it answers or drafts a reply. An admin
// edits them in Settings; every edit keeps the old text in KnowledgeEntryVersion. Entries are archived, never deleted.
model KnowledgeEntry {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  // A stable slug, unique per business, so importing the default policy twice never makes a duplicate.
  key         String
  category    String
  title       String
  body        String
  // STATUTORY (a legal right), VOLUNTARY (the store's own policy), PROCESS (how to do something), INFO (facts).
  basis       String   @default("INFO")
  // Words customers use for this topic; searched along with the title and body.
  keywords    String[]
  // ACTIVE or ARCHIVED
  status      String   @default("ACTIVE")
  version     Int      @default(1)
  // Set when the entry came from the shipped default policy and has not been edited since.
  fromDefault Boolean  @default(false)
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  versions KnowledgeEntryVersion[]

  @@unique([tenantId, key])
  @@index([tenantId, status, category])
}

model KnowledgeEntryVersion {
  id          String         @id @default(cuid())
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  entryId     String
  entry       KnowledgeEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  version     Int
  title       String
  body        String
  status      String
  editedById  String?
  createdAt   DateTime       @default(now())

  @@unique([entryId, version])
  @@index([tenantId, entryId])
}

// ─── Invoices ───────────────────────────────────────────

model Invoice {
  id          String        @id @default(cuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  number      String
  status      InvoiceStatus @default(DRAFT)
  invoiceDate DateTime
  currency    String        @default("USD")
  // Supplier (who issued the invoice)
  vendorName  String
  vendorRep   String?
  vendorPhone String?
  // Customer the invoice is addressed to
  billTo      String
  subtotal    Decimal       @default(0) @db.Decimal(14, 2)
  shipping    Decimal       @default(0) @db.Decimal(14, 2)
  // Negotiated amount the order actually closed at ("deal price")
  total       Decimal       @default(0) @db.Decimal(14, 2)
  notes       String?
  ownerId     String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  owner User          @relation("InvoiceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  items InvoiceItem[]
  // Customer deals this stock order fulfils
  deals Deal[]

  @@unique([tenantId, number])
  @@index([ownerId])
  @@index([invoiceDate])
  @@index([tenantId])
}

model InvoiceItem {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  invoiceId    String
  position     Int
  // Line reference on the supplier sheet, e.g. "1-1"
  ref          String
  style        String
  description  String
  color        String?
  density      String?
  lengthInches Int?
  quantity     Int
  unitPrice    Decimal  @db.Decimal(14, 2)
  lineTotal    Decimal  @db.Decimal(14, 2)
  // Handwritten resale price per piece
  resalePrice  Decimal? @db.Decimal(14, 2)
  note         String?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, position])
  @@index([tenantId])
}

// ─── Customer payments ──────────────────────────────────

// Money received against a deal. The balance is deal.amount minus the sum of these.
model Payment {
  id            String        @id @default(cuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  dealId        String
  amount        Decimal       @db.Decimal(14, 2)
  paidAt        DateTime
  method        PaymentMethod @default(BANK_TRANSFER)
  reference     String?
  note          String?
  // Null for online payments (nobody typed them in): the payment link and audit log show where they came from.
  recordedById  String?
  source        PaymentSource @default(MANUAL)
  // Stripe PaymentIntent id. Unique, so a repeated webhook can never record the same payment twice.
  providerRef   String?       @unique
  paymentLinkId String?       @unique
  createdAt     DateTime      @default(now())

  deal        Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  recordedBy  User?        @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  paymentLink PaymentLink? @relation(fields: [paymentLinkId], references: [id], onDelete: SetNull)

  @@index([dealId, paidAt])
  @@index([recordedById])
  @@index([tenantId])
  @@index([tenantId, paidAt])
}

// A Stripe-hosted page where a customer pays part of a deal's balance online. Pending links reserve
// their amount, so links can never add up to more than what is still owed.
model PaymentLink {
  id             String            @id @default(cuid())
  tenantId       String
  tenant         Tenant            @relation(fields: [tenantId], references: [id])
  dealId         String
  amount         Decimal           @db.Decimal(14, 2)
  currency       String
  status         PaymentLinkStatus @default(PENDING)
  // Stripe Payment Link id (plink_...) and its public URL; null only while it is being created.
  providerLinkId String?           @unique
  url            String?
  note           String?
  createdById    String
  createdAt      DateTime          @default(now())
  paidAt         DateTime?

  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  createdBy User     @relation("PaymentLinkCreator", fields: [createdById], references: [id], onDelete: Restrict)
  payment   Payment?

  @@index([dealId, status])
  @@index([createdById])
  @@index([tenantId])
}

// A private link a customer opens to see one order: what is paid, what is due and when (Plan A: customer payment
// page). The token is shown to staff and sent to the customer, never stored in the clear: `tokenHash` (SHA-256) is
// how a visit finds the row, and `tokenSealed` (encrypted, same key as the other secrets) lets staff and reminders
// show the same link again. Making a new link revokes the old one. An expired or revoked link shows nothing.
model CustomerOrderLink {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  dealId       String
  tokenHash    String    @unique
  tokenSealed  String
  expiresAt    DateTime
  revokedAt    DateTime?
  lastViewedAt DateTime?
  viewCount    Int       @default(0)
  createdById  String
  createdAt    DateTime  @default(now())

  deal      Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  createdBy User @relation("CustomerOrderLinkCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([tenantId, dealId])
  @@index([createdById])
}

// Optional agreed due dates for a deal. Payments are applied to these oldest-first.
model Instalment {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  dealId         String
  position       Int
  dueDate        DateTime
  amount         Decimal   @db.Decimal(14, 2)
  // Set when the due-soon reminder email went out (or when nothing was left to chase).
  reminderSentAt DateTime?

  deal      Deal                 @relation(fields: [dealId], references: [id], onDelete: Cascade)
  reminders InstalmentReminder[]

  @@index([dealId, dueDate])
  @@index([tenantId])
}

enum InstalmentReminderKind {
  UPCOMING
  OVERDUE_1
  OVERDUE_2
}

// One row per reminder email sent to a customer about an instalment. The unique key is what stops a
// repeated daily run from sending the same reminder twice.
model InstalmentReminder {
  id           String                 @id @default(cuid())
  tenantId     String
  tenant       Tenant                 @relation(fields: [tenantId], references: [id])
  instalmentId String
  kind         InstalmentReminderKind
  // True for emails sent to the admin in test mode; kept apart so going live still sends the real ones.
  test         Boolean                @default(false)
  // EMAIL or WHATSAPP: each channel is tracked on its own.
  channel      String                 @default("EMAIL")
  recipient    String
  sentAt       DateTime               @default(now())

  instalment Instalment @relation(fields: [instalmentId], references: [id], onDelete: Cascade)

  @@unique([instalmentId, kind, test, channel])
  @@index([instalmentId])
  @@index([tenantId])
}

// ─── Deal line items ────────────────────────────────────

// What a customer bought on a deal. When a deal has items, deal.amount is their total.
model DealItem {
  id           String  @id @default(cuid())
  tenantId     String
  tenant       Tenant  @relation(fields: [tenantId], references: [id])
  dealId       String
  position     Int
  productType  String
  texture      String?
  lengthInches String?
  color        String?
  laceType     String?
  quantity     Int
  unitPrice    Decimal @db.Decimal(14, 2)
  note         String?

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId, position])
  @@index([tenantId])
}

// ─── Stock adjustments ──────────────────────────────────

// Manual correction to computed stock (on hand = bought - sold + adjustments). Matched to a stock
// row on product + colour + length, the same way sold items are.
model StockAdjustment {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  product      String
  color        String   @default("")
  lengthInches Int?
  // Signed: positive adds pieces (found, opening stock), negative removes them (damaged, lost).
  quantity     Int
  reason       String
  note         String?
  ownerId      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  owner User @relation("StockAdjustmentOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([ownerId])
  @@index([tenantId])
}

// When to warn that a stock row is running low. Stock rows are worked out, not stored, so a row is named by its
// key (normalised product|colour|length, see stockKey in src/lib/stock.ts). A row exists only once someone sets
// a level for it or an alert went out for it.
model StockThreshold {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  key          String
  product      String
  color        String   @default("")
  lengthInches Int?
  // Alert at or below this many pieces. Null: use the business default. 0: never alert for this row.
  threshold    Int?
  // Set when the low-stock email went out for the row; cleared once stock is back above its level, so one
  // dip is one email.
  alertedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, key])
  @@index([tenantId])
}

// ─── Audit log ──────────────────────────────────────────

// Append-only record of who did what. No foreign keys, so entries outlive the users and records they
// refer to. Deletes of money records keep a full snapshot in `data`.
model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  createdAt  DateTime @default(now())
  actorId    String?
  actorEmail String?
  action     String
  entity     String?
  entityId   String?
  summary    String?
  data       Json?
  ip         String?

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([entity, entityId])
  @@index([tenantId, createdAt])
}
