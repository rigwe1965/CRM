generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ──────────────────────────────────────────────

enum Role {
  ADMIN
  SALES
  SUPPORT
}

enum ContactType {
  LEAD
  PROSPECT
  CUSTOMER
  PARTNER
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
}

enum DealStage {
  QUALIFICATION
  DISCOVERY
  PROPOSAL
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  CANCELLED
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  DIGITAL
  OTHER
}

enum ActivityType {
  NOTE
  CALL
  EMAIL
  MEETING
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ─── Users & Auth.js tables ─────────────────────────────

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String
  passwordHash      String?
  role              Role      @default(SALES)
  isActive          Boolean   @default(true)
  emailVerified     DateTime?
  image             String?
  // Sessions issued before this moment are rejected (set on password change/reset).
  passwordChangedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  accounts           Account[]
  sessions           Session[]
  ownedOrganizations Organization[]    @relation("OrganizationOwner")
  ownedContacts      Contact[]         @relation("ContactOwner")
  ownedDeals         Deal[]            @relation("DealOwner")
  activities         Activity[]
  assignedTasks      Task[]            @relation("TaskAssignee")
  createdTasks       Task[]            @relation("TaskCreator")
  ownedInvoices      Invoice[]         @relation("InvoiceOwner")
  stockAdjustments   StockAdjustment[] @relation("StockAdjustmentOwner")
  recordedPayments   Payment[]         @relation("PaymentRecorder")

  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── CRM core ───────────────────────────────────────────

model Organization {
  id        String    @id @default(cuid())
  name      String
  domain    String?   @unique
  industry  String?
  size      Int?
  website   String?
  phone     String?
  address   String?
  city      String?
  state     String?
  country   String?
  ownerId   String?
  // Soft delete: rows with deletedAt set are hidden by the API.
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  owner      User?      @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  contacts   Contact[]
  deals      Deal[]
  activities Activity[]

  @@index([name])
  @@index([ownerId])
  @@index([industry])
  @@index([deletedAt])
}

model Contact {
  id             String      @id @default(cuid())
  firstName      String
  lastName       String
  email          String?     @unique
  phone          String?
  title          String?
  type           ContactType @default(LEAD)
  leadStatus     LeadStatus? @default(NEW)
  source         String?
  // Shipping / home address
  address        String?
  city           String?
  state          String?
  postalCode     String?
  country        String?
  organizationId String?
  ownerId        String?
  // Soft delete: rows with deletedAt set are hidden by the API.
  deletedAt      DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  owner        User?         @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  deals        Deal[]
  activities   Activity[]
  tasks        Task[]

  @@index([lastName, firstName])
  @@index([type])
  @@index([leadStatus])
  @@index([organizationId])
  @@index([ownerId])
  @@index([deletedAt])
}

model Deal {
  id                String    @id @default(cuid())
  title             String
  amount            Decimal   @default(0) @db.Decimal(14, 2)
  currency          String    @default("USD")
  stage             DealStage @default(QUALIFICATION)
  probability       Int       @default(10)
  expectedCloseDate DateTime?
  closedAt          DateTime?
  lostReason        String?
  // Hair order details (all optional)
  productType       String?
  texture           String?
  lengthInches      String?
  color             String?
  laceType          String?
  quantity          Int?
  organizationId    String?
  contactId         String?
  ownerId           String
  // Soft delete: rows with deletedAt set are hidden by the API.
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  contact      Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  owner        User          @relation("DealOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  activities   Activity[]
  tasks        Task[]
  invoices     Invoice[]
  payments     Payment[]
  instalments  Instalment[]
  items        DealItem[]

  @@index([stage])
  @@index([expectedCloseDate])
  @@index([ownerId, stage])
  @@index([organizationId])
  @@index([contactId])
  @@index([deletedAt])
}

model Activity {
  id             String       @id @default(cuid())
  type           ActivityType @default(NOTE)
  subject        String
  body           String?
  occurredAt     DateTime     @default(now())
  authorId       String
  contactId      String?
  dealId         String?
  organizationId String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  author       User          @relation(fields: [authorId], references: [id], onDelete: Restrict)
  contact      Contact?      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deal         Deal?         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([occurredAt])
  @@index([authorId])
  @@index([contactId])
  @@index([dealId])
  @@index([organizationId])
}

model Task {
  id             String       @id @default(cuid())
  title          String
  description    String?
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  dueDate        DateTime?
  completedAt    DateTime?
  // Set when the due-soon reminder email went out; cleared when the due date changes.
  reminderSentAt DateTime?
  assigneeId     String
  createdById    String
  contactId      String?
  dealId         String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  assignee  User     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  createdBy User     @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([assigneeId, status, dueDate])
  @@index([createdById])
  @@index([contactId])
  @@index([dealId])
}

// ─── Invoices ───────────────────────────────────────────

model Invoice {
  id          String        @id @default(cuid())
  number      String        @unique
  status      InvoiceStatus @default(DRAFT)
  invoiceDate DateTime
  currency    String        @default("USD")
  // Supplier (who issued the invoice)
  vendorName  String
  vendorRep   String?
  vendorPhone String?
  // Customer the invoice is addressed to
  billTo      String
  subtotal    Decimal       @default(0) @db.Decimal(14, 2)
  shipping    Decimal       @default(0) @db.Decimal(14, 2)
  // Negotiated amount the order actually closed at ("deal price")
  total       Decimal       @default(0) @db.Decimal(14, 2)
  notes       String?
  ownerId     String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  owner User          @relation("InvoiceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  items InvoiceItem[]
  // Customer deals this stock order fulfils
  deals Deal[]

  @@index([ownerId])
  @@index([invoiceDate])
}

model InvoiceItem {
  id           String   @id @default(cuid())
  invoiceId    String
  position     Int
  // Line reference on the supplier sheet, e.g. "1-1"
  ref          String
  style        String
  description  String
  color        String?
  density      String?
  lengthInches Int?
  quantity     Int
  unitPrice    Decimal  @db.Decimal(14, 2)
  lineTotal    Decimal  @db.Decimal(14, 2)
  // Handwritten resale price per piece
  resalePrice  Decimal? @db.Decimal(14, 2)
  note         String?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, position])
}

// ─── Customer payments ──────────────────────────────────

// Money received against a deal. The balance is deal.amount minus the sum of these.
model Payment {
  id           String        @id @default(cuid())
  dealId       String
  amount       Decimal       @db.Decimal(14, 2)
  paidAt       DateTime
  method       PaymentMethod @default(BANK_TRANSFER)
  reference    String?
  note         String?
  recordedById String
  createdAt    DateTime      @default(now())

  deal       Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  recordedBy User @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([dealId, paidAt])
  @@index([recordedById])
}

// Optional agreed due dates for a deal. Payments are applied to these oldest-first.
model Instalment {
  id             String    @id @default(cuid())
  dealId         String
  position       Int
  dueDate        DateTime
  amount         Decimal   @db.Decimal(14, 2)
  // Set when the due-soon reminder email went out (or when nothing was left to chase).
  reminderSentAt DateTime?

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId, dueDate])
}

// ─── Deal line items ────────────────────────────────────

// What a customer bought on a deal. When a deal has items, deal.amount is their total.
model DealItem {
  id           String  @id @default(cuid())
  dealId       String
  position     Int
  productType  String
  texture      String?
  lengthInches String?
  color        String?
  laceType     String?
  quantity     Int
  unitPrice    Decimal @db.Decimal(14, 2)
  note         String?

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId, position])
}

// ─── Stock adjustments ──────────────────────────────────

// Manual correction to computed stock (on hand = bought - sold + adjustments). Matched to a stock
// row on product + colour + length, the same way sold items are.
model StockAdjustment {
  id           String   @id @default(cuid())
  product      String
  color        String   @default("")
  lengthInches Int?
  // Signed: positive adds pieces (found, opening stock), negative removes them (damaged, lost).
  quantity     Int
  reason       String
  note         String?
  ownerId      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  owner User @relation("StockAdjustmentOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([ownerId])
}
